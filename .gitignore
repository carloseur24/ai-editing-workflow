# ---------------------------------------------------------------------------
# This is a public, agentic repo: source and intent travel, media does not.
# Anything a fresh clone can rebuild or must source locally stays here.
# ---------------------------------------------------------------------------

# Python environments and caches
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Model weights, normalised-clip cache, ASR cache (rebuildable)
.cache/

# Every render is reproducible from input/ + config/
output/

# Machine-local config overlay (Windows paths, personal delivery shelf)
config/pipeline.local.json

# Media anywhere: footage, voiceovers, music, SFX, plates, renders
*.mp4
*.mov
*.m4v
*.webm
*.mkv
*.wav
*.mp3
*.m4a
*.flac
*.aiff
*.aif

# Generated procedural SFX core (README + wavs); reinstall with --install-library
assets/sfx/fenix_sfx/

# A 50-byte existence-only fixture; schema/graph tests never decode it
!tests/fixtures/placeholder.mp4

# Derived per-project data (regenerated by frames/align/plan)
input/*/clips/
input/*/keyframes/
input/*/keyframe_report.json
input/*/candidates.json
input/*/edit_plan*.json
input/*/narration_lines.json
input/*/word_timings.json
input/*/.asr_cache.json
input/*/_voice*.wav
input/*/voice.*

# Footage-intake work directory (disposable, lives beside the scanned folder)
.fenix-label/

# HyperFrames render state and snapshots
.hyperframes/
**/.hyperframes/

# Editor and OS noise
.DS_Store
Thumbs.db
*.swp
*.swo
*.log
