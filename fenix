#!/usr/bin/env bash
# fenix — run the pipeline from any working directory.
#
# The package lives in src/; this launcher puts it on PYTHONPATH and uses the
# project venv when it exists. No editable install is required.
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PY="$ROOT/.venv/bin/python"
if [ ! -x "$PY" ]; then
  PY="$(command -v python3)"
fi

export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m fenixsoft "$@"
