{
  "version": 4,
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 60
  },
  "target_duration_sec": 28.0,
  "bpm": 120,
  "cuts_per_video": 16,
  "cut_snap_to_beat": true,
  "min_cut_sec": 1.2,
  "shots": {
    "source_tolerance_sec": 0.02,
    "sum_tolerance_sec": 0.25
  },
  "script": {
    "spoken_wpm": 162,
    "max_tempo": 1.12
  },
  "quality": {
    "in_point_floor": 0.6,
    "beat_offset_warn_ms": 60,
    "beat_offset_fail_ms": 120,
    "caption_warn_cps": 20,
    "caption_fail_cps": 25,
    "max_duration_sec": 28.5,
    "beat_policy": "music",
    "bpm_tolerance": 1.5
  },
  "punch": {
    "enabled": false,
    "duration_sec": 0.16,
    "scale": 1.12,
    "ease": "out_cubic"
  },
  "transitions": {
    "enabled": false,
    "default": "dissolve",
    "sec": 0.35
  },
  "post": {
    "motion": true,
    "comp": true
  },
  "layout": {
    "bottom_stack_shift_pct": 0.2
  },
  "grade": {
    "mode": "baked",
    "lightness_alpha": 1.06,
    "lightness_beta": 3
  },
  "encoding": {
    "codec": "libx264",
    "preset": "medium",
    "profile": "main",
    "level": "4.2",
    "pix_fmt": "yuv420p",
    "crf": 18,
    "maxrate": "3800k",
    "bufsize": "7600k",
    "fallback_crf": 21,
    "fallback_maxrate": "2500k",
    "audio_codec": "aac",
    "audio_bitrate": "128k",
    "audio_sample_rate": 48000,
    "max_whatsapp_bytes": 16252928,
    "faststart": true
  },
  "audio": {
    "target_lufs": -14.0,
    "true_peak_db": -1.5,
    "limiter_ceiling": 0.78,
    "lra": 11.0,
    "music_bed_lufs": -28.0,
    "duck_ratio": 4.0,
    "duck_threshold": 0.03,
    "duck_attack_ms": 8,
    "duck_release_ms": 350,
    "music_fade_in_sec": 0.25,
    "music_fade_out_sec": 0.7,
    "sfx_gain_db": -17.4,
    "sfx_fade_sec": 0.3,
    "music_only": {
      "bed_lufs": -18.0,
      "sfx_dbfs": -16.0
    }
  },
  "music": {
    "file": "assets/music/groove_118bpm.wav",
    "bpm": 118
  },
  "sfx": {
    "file": "assets/sfx/whoosh_short.wav",
    "on_every_cut": true,
    "align_peak_to_cut": true,
    "mode": "cue_sheet",
    "library_dir": "assets/sfx",
    "library_manifest": "assets/sfx/library.json",
    "install_subdir": "fenix_sfx",
    "cue_sheet_file": "sfx_cue_sheet.json",
    "bus_file": "sfx_bus.wav",
    "music_bed_file": "music_bed.wav",
    "duck_db": -4.5,
    "duck_attack_ms": 8,
    "duck_release_ms": 350,
    "vacuum_ms": 120,
    "jcut_min_ms": 150,
    "sub_spacing_sec": 1.5,
    "bus_peak_db": -16.0
  },
  "colors": {
    "emerald_primary": "#059669",
    "emerald_flash": "#10B981",
    "text_white": "#FFFFFF",
    "text_mint": "#D1FAE5",
    "pill_dark": "#111827"
  },
  "safe_zones": {
    "reels_universal": {
      "x_min": 65,
      "x_max": 950,
      "header_y_start": 110,
      "title_y": 118,
      "sub_y": 194,
      "badge_y": 254,
      "price_y": 1310,
      "caption_y": 1445,
      "footer_y": 1585
    },
    "status_story": {
      "x_min": 65,
      "x_max": 1015,
      "header_y_start": 110,
      "title_y": 118,
      "sub_y": 194,
      "badge_y": 254,
      "price_y": 1350,
      "caption_y": 1485,
      "footer_y": 1625
    }
  },
  "typography": {
    "title_size": 58,
    "subtitle_size": 34,
    "badge_size": 26,
    "price_size": 54,
    "footer_size": 28,
    "caption_size": 46,
    "min_size": 24
  },
  "kinetic_captions": {
    "font_size": 46,
    "max_words_per_chunk": 4,
    "max_chars_per_chunk": 26,
    "active_flash_ms": 90,
    "pill_settle_ms": 120,
    "phrase_enter_ms": 100,
    "hold_last_gap_ms": 600
  },
  "text_cards": {
    "y": 250,
    "size": 86,
    "sub_size": 34,
    "color": "#FFFFFF",
    "sub_color": "#6EE7B7",
    "enter_sec": 0.45,
    "exit_sec": 0.3,
    "rise_px": 24,
    "sub_gap_ratio": 0.3,
    "shadow": true
  },
  "alignment": {
    "engine": "faster-whisper",
    "model": "small",
    "compute_type": "int8",
    "language": "es",
    "beam_size": 5,
    "cpu_threads": 8,
    "trim_tail_to_script": true,
    "min_script_similarity": 0.55
  },
  "voiceover": {
    "silence_threshold_db": -38.0,
    "min_silence_sec": 0.26,
    "keep_pad_sec": 0.05,
    "max_tempo": 1.3,
    "crossfade_sec": 0.012,
    "end_pad_sec": 0.12,
    "tail_extension_max_sec": 0.8,
    "max_extra_sec": 2.0,
    "tail_pad_sec": 0.35
  },
  "delivery": {
    "dir": "output/delivery",
    "copy": [
      "*_final.mp4",
      "contact_sheet.png",
      "qa_report.json",
      "caption_audit.json",
      "*.md",
      "edit_plan.json",
      "word_timings.json",
      "sfx_cue_sheet.json",
      "sfx_report.json"
    ],
    "downloads": "output/delivery_downloads",
    "copy_to_downloads": true,
    "prune_local_media": true
  },
  "labeling": {
    "jobs": 8,
    "sheet_tile_width": 400,
    "grid_cols": 4,
    "grid_rows": 2,
    "grid_cell_width": 300,
    "duplicate_threshold": 8,
    "name_max_len": 80
  },
  "preview": {
    "max_stills": 24,
    "tile_width": 270,
    "tile_height": 480,
    "columns": 4
  }
}
