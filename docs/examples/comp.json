{
  "base": "input/<project>/clips/base.mp4",
  "width": 1080,
  "height": 1920,
  "fps": 60,
  "duration": 10,
  "layers": [
    {
      "src": "output/<project>/motion/<run>/plate.mov",
      "start": 1.0,
      "end": 5.0,
      "x": 0.5,
      "y": 0.5,
      "scale": 1.0,
      "opacity": 1.0,
      "move": {"from": [0.5, 0.55], "to": [0.5, 0.45]},
      "mask": {"type": "rect", "x": 0.1, "y": 0.1, "w": 0.8, "h": 0.8},
      "key": {"color": "#00ff00", "similarity": 0.12, "blend": 0.05}
    },
    {
      "src": "output/<project>/motion/<run>/plate.mov",
      "start": 5.0,
      "end": 9.0,
      "track": "output/<project>/track/track_<stamp>.json",
      "mask": {"type": "ellipse", "x": 0.5, "y": 0.45, "w": 0.5, "h": 0.6},
      "opacity": 0.9
    }
  ],
  "fade_in": 0.3,
  "fade_out": 0.4
}
